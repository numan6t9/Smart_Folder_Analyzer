<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="searchPanalMainPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="project.smart_file_analyzer.FileAnalyzerViewController"
            style="-fx-background-color: #F5F7FA;">

    <children>

        <VBox prefWidth="250.0"
              spacing="20.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              style="-fx-background-color: #111827;">

            <padding>
                <Insets top="40.0"
                        right="20.0"
                        bottom="25.0"
                        left="20.0"/>
            </padding>

            <VBox spacing="4.0">

                <Label text="SMART"
                       style="-fx-font-size: 27px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Label text="FILE ANALYZER"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #60A5FA;"/>

                <Label text="Search • Analyze • Organize"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #9CA3AF;"/>

            </VBox>

            <VBox spacing="8.0">

                <Label text="MENU"
                       style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #6B7280;
                              -fx-padding: 10 10 5 10;"/>

                <Button text="Search Files"
                        onAction="#searchFolder"
                        maxWidth="Infinity"
                        prefHeight="46.0"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: #2563EB;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;
                               -fx-padding: 0 15 0 15;"/>

                <Button text="Browse Folder"
                        onAction="#browseFolder"
                        maxWidth="Infinity"
                        prefHeight="46.0"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-text-fill: #D1D5DB;
                               -fx-padding: 0 15 0 15;"/>

                <Button text="File Statistics"
                        onAction="#showStatistics"
                        maxWidth="Infinity"
                        prefHeight="46.0"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-text-fill: #D1D5DB;
                               -fx-padding: 0 15 0 15;"/>

            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <VBox spacing="4.0">

                <Label text="Smart File Analyzer"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #9CA3AF;"/>

                <Label text="Version 1.0"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #6B7280;"/>

            </VBox>

        </VBox>

        <VBox spacing="22.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="250.0"
              AnchorPane.rightAnchor="0.0">

            <padding>
                <Insets top="35.0"
                        right="40.0"
                        bottom="25.0"
                        left="40.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5.0">

                    <Label text="File Search"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                    <Label text="Search and analyze files from your computer."
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #64748B;"/>

                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT"
                      spacing="3.0">

                    <Label text="STATUS"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label text="Ready"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #16A34A;"/>

                </VBox>

            </HBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #E2E8F0;
                         -fx-border-radius: 12;">

                <padding>
                    <Insets top="20.0"
                            right="22.0"
                            bottom="20.0"
                            left="22.0"/>
                </padding>

                <Label text="Folder Location"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #334155;"/>

                <HBox spacing="10.0">

                    <TextField fx:id="enterFolderPath"
                               promptText="Enter folder path..."
                               prefHeight="40.0"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #F8FAFC;
                                      -fx-border-color: #CBD5E1;
                                      -fx-border-radius: 7;
                                      -fx-background-radius: 7;
                                      -fx-padding: 0 12 0 12;
                                      -fx-font-size: 13px;"/>

                    <Button text="Browse"
                            onAction="#browseFolder"
                            mnemonicParsing="false"
                            prefWidth="105.0"
                            prefHeight="40.0"
                            style="-fx-background-color: #E5E7EB;
                                   -fx-text-fill: #334155;
                                   -fx-background-radius: 7;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;"/>

                    <Button text="Search"
                            onAction="#searchFolder"
                            mnemonicParsing="false"
                            prefWidth="105.0"
                            prefHeight="40.0"
                            style="-fx-background-color: #2563EB;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;"/>

                </HBox>

            </VBox>

            <HBox spacing="15.0">

                <VBox spacing="5.0"
                      prefHeight="75.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <padding>
                        <Insets top="15.0"
                                right="18.0"
                                bottom="15.0"
                                left="18.0"/>
                    </padding>

                    <Label text="FILES FOUND"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="fileCountLabel"
                           text="0"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                </VBox>

                <VBox spacing="5.0"
                      prefHeight="75.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <padding>
                        <Insets top="15.0"
                                right="18.0"
                                bottom="15.0"
                                left="18.0"/>
                    </padding>

                    <Label text="TOTAL SIZE"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="totalSizeLabel"
                           text="0 B"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                </VBox>

                <VBox spacing="5.0"
                      prefHeight="75.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <padding>
                        <Insets top="15.0"
                                right="18.0"
                                bottom="15.0"
                                left="18.0"/>
                    </padding>

                    <Label text="LARGEST FILE"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="largestFileLabel"
                           text="N/A"
                           maxWidth="Infinity"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="3.0">

                    <Label text="Search Results"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                    <Label text="Files discovered in the selected folder"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #64748B;"/>

                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <Label text="File Details"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #94A3B8;"/>

            </HBox>

            <TableView fx:id="folderDataTableView"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-border-color: #E2E8F0;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;">

                <columns>

                    <TableColumn fx:id="fileNameTV"
                                 text="File Name"
                                 prefWidth="250.0"
                                 minWidth="150.0"/>

                    <TableColumn fx:id="fileTypeTV"
                                 text="File Type"
                                 prefWidth="170.0"
                                 minWidth="100.0"/>

                    <TableColumn fx:id="fileSizeTV"
                                 text="File Size"
                                 prefWidth="140.0"
                                 minWidth="90.0"/>

                    <TableColumn fx:id="fileLocationTV"
                                 text="File Location"
                                 prefWidth="500.0"
                                 minWidth="200.0"/>

                </columns>

            </TableView>

            <HBox alignment="CENTER_LEFT">

                <Label text="Smart File Analyzer • File Search"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #94A3B8;"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Label text="Ready"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #16A34A;"/>

            </HBox>

        </VBox>

    </children>

</AnchorPane>